# Copy this file to ".env" and fill in real values.
# The API reads these on startup and they override appsettings.json.
#
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)

# PostgreSQL connection string (double underscores map to ":" in appsettings.json)
# Replace the username/password/database with your own.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_db;Username=postgres;Password=password

# JWT signing settings.
# IMPORTANT: replace this secret with a random 32+ byte value, e.g. generated with:
#   openssl rand -hex 32
# or on PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
Jwt__Issuer=AssignmentManagement.Api
Jwt__Audience=AssignmentManagement.Web
Jwt__Secret=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING_0123456789abcdef0123456789abcdef
Jwt__ExpiryMinutes=60

# CORS allowed browser origins (one entry per index)
Cors__AllowedOrigins__0=http://localhost:3000

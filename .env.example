# Copy this to ".env" and put your own values in. Anything here overrides
# appsettings.json when the API starts.
#
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)

# PostgreSQL connection string. Double underscores map to ":" in appsettings.json,
# so this is the same as ConnectionStrings:DefaultConnection.
# Swap in your real database name / user / password.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_db;Username=postgres;Password=password

# JWT signing key. Generate your own, don't use this one in production:
#   openssl rand -hex 32
# or in PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
Jwt__Issuer=AssignmentManagement.Api
Jwt__Audience=AssignmentManagement.Web
Jwt__Secret=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING_0123456789abcdef0123456789abcdef
Jwt__ExpiryMinutes=60

# Which browser origins are allowed to call the API (one line per origin).
Cors__AllowedOrigins__0=http://localhost:3000
